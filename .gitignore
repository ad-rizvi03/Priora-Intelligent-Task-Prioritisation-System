# ============================================================
# Root .gitignore for Priora (Gravity Canvas)
# ============================================================

# ============================================================
# SECURITY — Never commit credentials or secrets
# ============================================================
**/application.properties
**/application-local.properties
**/application-dev.properties
**/application-prod.properties
**/.env
**/.env.*
!**/.env.example
!**/application.properties.example

# ============================================================
# Java / Maven (Backend)
# ============================================================
target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ============================================================
# Node / Angular (Frontend)
# ============================================================
node_modules/
dist/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ============================================================
# IDE & Editor Files
# ============================================================
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# ============================================================
# OS Files
# ============================================================
.DS_Store
Desktop.ini
$RECYCLE.BIN/
